{
    "dev.containers.reopenOnFolderWithDevcontainer": "always", 
    "rewrap.autoWrap.enabled": false,
    "editor.rulers": [80],
    "[markdown]": {
        "editor.formatOnType": false
    },
    "files.watcherExclude": {
        "**/node_modules/*/**": true,
        "**/tmp/**": true
    },
     "remote.extensionKind": {
         "yzhang.markdown-all-in-one": ["workspace"],
         "davidanson.vscode-markdownlint": ["ui"]
    }
}